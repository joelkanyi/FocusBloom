import kotlin.Int;

CREATE TABLE focusSession (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    label TEXT NOT NULL,
    focusMinutes INTEGER AS Int NOT NULL,
    shortBreakMinutes INTEGER AS Int NOT NULL,
    longBreakMinutes INTEGER AS Int NOT NULL,
    cycles INTEGER AS Int NOT NULL,
    taskId INTEGER
);

selectAll:
SELECT * FROM focusSession;

selectById:
SELECT * FROM focusSession WHERE id = ?;

insert:
INSERT INTO focusSession(label, focusMinutes, shortBreakMinutes, longBreakMinutes, cycles, taskId)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM focusSession WHERE id = ?;
